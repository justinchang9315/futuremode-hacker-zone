APP_NAME=Child Teaching Companion API
ENVIRONMENT=development
API_PREFIX=/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Zero-setup local default:
DATABASE_URL=sqlite:///./companion.db

# Recommended PostgreSQL setting:
# DATABASE_URL=postgresql+psycopg://companion:companion@localhost:5432/companion

AUTO_CREATE_SCHEMA=true
SEED_DEMO_CONTENT=true
APP_SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_MINUTES=30
SESSION_DURATION_MINUTES=10
REQUESTS_PER_MINUTE=120
MAX_AUDIO_BYTES=5000000
MAX_LLM_RESPONSE_CHARS=240

# Active LLM provider: gemini, fake, openai, gmi_cloud, or eastrouter.
LLM_PROVIDER=fake
LLM_TIMEOUT_SECONDS=30

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional OpenAI provider
LLM_MODEL=gpt-4o
# Only an OpenAI Platform key belongs here. Do not use the Atlas Oracle key.
OPENAI_API_KEY=

# GMI Cloud OpenAI-compatible endpoint
GMI_CLOUD_API_KEY=
GMI_CLOUD_BASE_URL=https://api.gmi-serving.com/v1
GMI_CLOUD_MODEL=deepseek-ai/DeepSeek-R1

# EastRouter: copy these values from the provider's official documentation.
EASTROUTER_API_KEY=
EASTROUTER_BASE_URL=
EASTROUTER_MODEL=
ASR_PROVIDER=fake
ASR_API_KEY=
TTS_API_KEY=

# Versioned policies
SCORE_POLICY_VERSION=reading-v1
REWARD_POLICY_VERSION=reward-v1
SAFETY_POLICY_VERSION=safety-v1

# Assessment thresholds
MIN_AUDIO_QUALITY=0.50
MIN_BROWSER_ASR_CONFIDENCE=0.55
MIN_ASSESSMENT_CONFIDENCE=0.65
GOOD_READING_SCORE=60
MASTERY_SCORE=80
MASTERY_CONFIDENCE=0.85

# Progression thresholds
LEVEL_2_LIFETIME_COINS=30
LEVEL_2_COMPLETED_CONTENTS=2
LEVEL_3_LIFETIME_GEMS=2
LEVEL_3_MASTERED_CONTENTS=2

# --- VoAI（絕好聲創）語音合成 ---------------------------------------
# 把 TTS_PROVIDER 改成 voai 就會啟用；保持 fake 則沿用瀏覽器內建語音。
# 金鑰只留在後端，前端一律透過 POST /v1/tts 取音檔。
# 文件：https://connect.voai.ai/doc-vocal/index.html
TTS_PROVIDER=fake
VOAI_API_KEY=
VOAI_BASE_URL=https://connect.voai.ai
# Neo 或 Classic。Neo 較新，取樣率上限 32000。
VOAI_MODEL=Neo
# 留空時第一次合成會自動用清單第一位；用 GET /v1/tts/speakers 查可用名稱後填進來。
# 男聲／女聲各一位，前端 Demo 控制台可即時切換。
# 留空會依聲優清單的 gender 自動挑一位；GET /v1/tts/speakers 可查全部。
VOAI_SPEAKER_MALE=辰辰
VOAI_SPEAKER_FEMALE=品妍
# 前端沒指定時用哪個：male 或 female
VOAI_DEFAULT_VOICE=male
VOAI_STYLE=預設
# speed 0.5-1.5、pitch_shift -5-5、style_weight 0-1、breath_pause 0-10
VOAI_SPEED=1.0
VOAI_PITCH_SHIFT=0
VOAI_STYLE_WEIGHT=0.0
VOAI_BREATH_PAUSE=0
# wav 或 mp3。pcm 是串流格式，瀏覽器的 <audio> 播不了。
VOAI_OUTPUT_FORMAT=mp3
# 8000 / 16000 / 32000 / 44100，留空用預設。
VOAI_SAMPLE_RATE=
VOAI_TIMEOUT_SECONDS=30
# 一句台詞的字數上限。VoAI 是 1 字 1 點，這同時是扣點的煞車。
MAX_TTS_CHARS=200
